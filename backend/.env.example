APP_NAME=rag

# development | production. In development an unreachable database falls back
# to a local SQLite file (backend/data/rag.db); in production it is an error,
# and the session cookie is only sent over HTTPS.
APP_ENV=development

# The Postgres container in docker-compose.yml, which run.bat starts.
# Leave empty to use a local SQLite file instead.
DATABASE_URL=postgresql://rag:rag@localhost:5434/rag

# Every instance has accounts, users and sign-in. The first visit to a new
# instance shows a setup page that creates the first account; that person owns
# it and runs the instance. These two settings decide what this server can do.

# Run models on this machine: transformers in the backend's memory, and LM Studio
# on its localhost. true for your own computer. false for a shared server, where
# those providers are still listed but cannot be picked.
LOCAL_MODELS=true

# Let anyone who reaches the sign-in page create an account of their own.
# false: after setup, only admins add people. true for a public instance.
OPEN_SIGNUP=false

# Encrypts stored API keys. Required when APP_ENV=production. Use a long random
# value and keep it: changing it makes every stored key unreadable.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Outside production one is generated into backend/data/secret.key when this is empty.
SECRET_KEY=

# How long a sign-in lasts.
SESSION_DAYS=30

# Web client ID from Google Cloud (APIs & Services, Credentials). Add this site's
# address to the client's authorized JavaScript origins. Sign in with Google is
# offered only when this is set.
GOOGLE_CLIENT_ID=

# With LOCAL_MODELS=false, provider addresses on private networks are refused.
# Set to true only to try that setup against a model server on your own machine.
ALLOW_PRIVATE_URLS=false

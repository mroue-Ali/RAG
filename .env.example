# Settings for running rag with docker compose, as on the VPS through webos.
# webos writes them to .env next to docker-compose.yml. Never commit that file.
# (Running from source on your own machine uses backend/.env instead.)

# Encrypts the API keys accounts store. Required. Generate it once and keep it:
# a new value makes every stored key unreadable.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# The database password, used only between the two containers. Any long random
# value. Set it before the first deploy: Postgres keeps the password it started with.
RAG_DB_PASSWORD=

# Anyone who reaches the site can create an account of their own.
OPEN_SIGNUP=true

# Web client ID from Google Cloud, to offer Sign in with Google. Optional.
GOOGLE_CLIENT_ID=

# How long a sign-in lasts, in days.
SESSION_DAYS=30
